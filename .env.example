# Sign up free at https://serpapi.com (no credit card needed for the free
# tier: 250 searches/month). Copy your key from the dashboard.
SERPAPI_KEY=your_serpapi_key_here

# Optional: override the port the local server runs on
PORT=4173

# Hard monthly cap on outgoing SerpApi searches. The background checker
# refuses to run once this is hit for the month, so you never get a
# surprise bill on the free tier (or blow past a paid plan's quota).
MONTHLY_SEARCH_BUDGET=250

# How often (in minutes) the background job looks for trips/wishlist items
# that are due for a recheck, based on each item's own cadence (see
# lib/scheduler.js). This is just the "how often to look", not "how often
# to actually call the API" — that's governed by cadence + the budget above.
SCHEDULER_TICK_MINUTES=60
